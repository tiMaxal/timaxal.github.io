def show_help():
    """Display help message"""
    help_text = """
HNS Portfolio Maker for timax.al
=================================

USAGE:
    python hns-portfolio-maker.py [options] <csv_files...>
    
    Or drag CSV files onto this script

OPTIONS:
    -h, --help              Show this help message
    -s, --settings FILE     Use settings file (default: portfolio-settings.json)
    -o, --output FILE       Output HTML filename (default: portfolio.html)
    -t, --title TITLE       Page title (default: HNS Portfolio)
    -e, --email EMAIL       Auto-append email for domains with price
                            Format: user@gmail.com or user+@gmail.com
    -c, --credits FILE      Credits HTML file to include above footer
    --save-settings         Save current settings to file
    --create-settings       Create example settings file

SUPPORTED CSV FORMATS:
    - Namebase TLD exports (name, unicode, tags columns)
    - Namebase Transactions (extra.domain column)
    - Shakestation TLD exports (domain, for_sale columns)
    - Shakestation Transactions (domain, coin columns)
    - Bob Wallet TLD lists (domains column or simple list)
    - Firewallet exports (expiry column)

NOTES:
    - Bob/Firewallet domains REQUIRE email or price columns to be displayed
    - Use --email option to auto-append email addresses for domains with prices
    - Shakestation TLD: only includes domains marked for_sale=TRUE
    - Output saved to: ../HTML/sellhns/ (relative to script location)

EXAMPLES:
    # Process single file with auto-email
    python hns-portfolio-maker.py -e user+@gmail.com domains.csv
    
    # Process multiple files with custom title
    pyProcess entire directory (recursive by default)
    python hns-portfolio-maker.py -e user+@gmail.com csv-s/
    
    # Process directory non-recursively
    python hns-portfolio-maker.py --no-recursive csv-nb/
    
    # thon hns-portfolio-maker.py -t "My Domains" file1.csv file2.csv
    
    # Use settings file
    python hns-portfolio-maker.py -s my-settings.json
    
    # Create example settings file
    python hns-portfolio-maker.py --create-settings

SETTINGS FILE FORMAT (JSON):
    {{
        "email": "user+@gmail.com",
        "output_filename": "portfolio.html",
        "title": "HNS Portfolio",
        "credits_file": "html/credits.html",
        "recursive": true,
        "csv_files": [
            "csv-nb/Namebase-export.csv",
            "csv-s/csv-ss/"
        ]
    }}
"""
    print(help_text)

def create_example_settings():
    """Create example settings file"""
    example_settings = {
        "email": "yourname+@gmail.com",
        "output_filename": "portfolio.html",
        "title": "HNS Portfolio",
        "recursive": True,
        "csv_files": [
            "csv-s/csv-nb/csv_nb-tld/Namebase-domains-export.csv",
            "csv-s/csv-ss/csvg_ss-tld/t.csv",
            "csv-s/csv-ss/csvg_ss-tld/hns_ss-export-tld.csv"
        ]
    }
    
    settings_file = "portfolio-settings.json"
    with open(settings_file, 'w', encoding='utf-8') as f:
        json.dump(example_settings, f, indent=2)
    
    print(f"Example settings file created: {settings_file}")
    print("Edit this file with your actual values and run:")
    print(f"  python {os.path.basename(__file__)} -s {settings_file}")

def main():
    """Main function with argument parsing"""
    parser = argparse.ArgumentParser(
        description='Generate HNS portfolio HTML pages for timax.al',
        add_help=False
    )
    parser.add_argument('-h', '--help', action='store_true', help='Show help message')
    parser.add_argument('-s', '--settings', help='Settings file path')
    parser.add_argument('-o', '--output', help='Output HTML filename')
    parser.add_argument('-t', '--title', help='Page title')
    parser.add_argument('-e', '--email', help='Auto-append email (format: user@gmail.com or user+@gmail.com)')
    parser.add_argument('-c', '--credits', help='Credits HTML file path')
    parser.add_argument('-r', '--recursive', action='store_true', default=True, help='Recursive directory search (default)')
    parser.add_argument('--no-recursive', action='store_false', dest='recursive', help='Disable recursive directory search')
    parser.add_argument('--save-settings', action='store_true', help='Save current settings')
    parser.add_argument('--create-settings', action='store_true', help='Create example settings file')
    parser.add_argument('csv_files', nargs='*', help='CSV files or directories to process')
    parser.add_argument('csv_files', nargs='*', help='CSV files to process')
    
    args = parser.parse_args()
    
    if args.help:
        show_help()
        return
    
    if args.create_settings:
        create_example_settings()
        return
    
    # Load settings file if specified
    recursive = args.recursive if hasattr(args, 'recursive') else settings.get('recursive', True)
    
    # Get CSV files/dirs from args or settings
    input_paths = args.csv_files if args.csv_files else settings.get('csv_files', [])
    
    if not input_paths:
        print("HNS Portfolio Maker for timax.al")
        print("=" * 50)
        print("\nNo CSV files or directories specified!")
        print("\nUSAGE:")
        print(f"  python {os.path.basename(__file__)} [options] <csv_files_or_dirs...>")
        print(f"  python {os.path.basename(__file__)} --help")
        print(f"  python {os.path.basename(__file__)} --create-settings")
        sys.exit(1)
    
    print("HNS Portfolio Maker for timax.al")
    print("=" * 50)
    
    # Expand directories to CSV files
    csv_files = []
    for path in input_paths:
        if not os.path.exists(path):
            print(f"Warning: Path not found: {path}")
            continue
        
        found_files = find_csv_files(path, recursive=recursive)
        if found_files:
            if os.path.isdir(path):
                print(f"\n📁 Found {len(found_files)} CSV file(s) in: {path}")
                if recursive:
                    print(f"   (recursive search)")
            csv_files.extend(found_files)
        elif os.path.isdir(path):
            print(f"Warning: No CSV files found in: {path}")
    
    if not csv_files:
        print("\n❌ No CSV files found!")
        sys.exit(1)
    
    print(f"\n📄 Total CSV files to process: {len(csv_files)}")
    
    all_domains = []
    
    # Process all CSV files
    for csv_file in csv_files:
        if not os.path.exists(csv_file):
            print(f"Warning: File not found: {csv_file}")
            continue
        
        print(f"\nProcessing: {os.path.basename(csv_file)}")
        source_type = detect_csv_source(csv_file)
        print(f"  Detected format: {source_type}")
        
        domains = process_csv(csv_file, auto_email)
        print(f"  Found {len(domains)} domains")
        
        if not domains and source_type in ['bob-tld', 'fw']:
            print(f"  Note: Bob/Firewallet domains require 'email' or 'price' columns")
            print(f"        Use --email option to auto-append email addresses")
        
        all_domains.extend(domains)
    
    if not all_domains:
        print("\n❌ No domains found in CSV files!")
        print("\nPossible reasons:")
        print("  - Bob/Firewallet CSVs missing 'email' or 'price' columns")
        print("  - Shakestation domains not marked for_sale=TRUE")
        print("  - Invalid CSV format")
        print("\nTry using --email option for Bob/Firewallet domains:")
        print("  python", os.path.basename(__file__), "--email user+@gmail.com", csv_files[0] if csv_files else "file.csv")
        sys.exit(1)
    
    print(f"\n✓ Total domains loaded: {len(all_domains)}")
    
    # Save settings if requested
    if args.save_settings:
        save_settings({
            'email': auto_email,
            'output_filename': output_filename,
            'title': title,
            'recursive': recursive,
            'csv_files': input_pathts_file,
            'csv_files': csv_files
        }, args.settings or 'portfolio-settings.json')
    
    # Ensure output filename has .html extension
    if not output_filename.endswith('.html'):
        output_filename += '.html'
    
    # Determine output path (../HTML/sellhns/ relative to script)
    script_dir = Path(__file__).parent
    output_dir = script_dir.parent.parent / \"HTML\" / "sellhns"
    output_dir.mkdir(parents=True, exist_ok=True)
    output_path = output_dir / output_filename
    
    # Resolve credits file path if provided
    credits_path = None
    if credits_file:
        # Try relative to script dir first
        test_path = script_dir.parent / credits_file
        if test_path.exists():
            credits_path = test_path
        elif os.path.exists(credits_file):
            credits_path = credits_file
        else:
            print(f"Warning: Credits file not found: {credits_file}")
    
    print(f"\nGenerating HTML...")
    html_content = generate_html(all_domains, output_filename, title, credits_path)
    
    # Write file
    with open(output_path, 'w', encoding='utf-8') as f:
        f.write(html_content)
    
    print(f"\n✓ Portfolio created: {output_path}")
    print(f"\nView at: file:///{output_path.as_posix()}")
    
    if auto_email:
        print(f"Auto-email: {auto_email}")

if __name__ == "__main__":
    main()

